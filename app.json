{
  "expo": {
    "name": "Verbol",
    "slug": "verbol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/verbol-icon.png",
    "scheme": "verbol",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "permissions": [
      "android.permission.RECORD_AUDIO",
      "ios.permission.MICROPHONE"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses your microphone to record audio.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/verbol-foreground.png",
        "monochromeImage": "./assets/images/verbol-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.ayush008.aiwrapper"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "309ae52f-165c-4a44-9e38-aac046f47e65"
      }
    },
    "owner": "ayush008"
  }
}
