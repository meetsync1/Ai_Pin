# .gitignore for Agentic AI Project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data
data/logs/*.log
data/memory/*.json
data/checkpoints/*.pt
data/checkpoints/*.pth
data/training/*
*.mp3
*.wav
*.srt
*.txt

# Keep directory structure
!data/logs/.gitkeep
!data/memory/.gitkeep
!data/knowledge_base/.gitkeep
!data/training/.gitkeep
!data/checkpoints/.gitkeep

# Models
models/
*.bin
*.safetensors
*.onnx

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
